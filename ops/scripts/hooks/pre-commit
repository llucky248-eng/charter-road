#!/usr/bin/env bash
# Guards three invariants when src/main.js is staged:
#   1. index.html version must match (consistency)
#   2. version must be bumped from the last commit (progress)
#   3. for non-version-only changes, ITERATION.whatsNew must be updated
STAGED=$(git diff --cached --name-only)
if echo "$STAGED" | grep -q "^src/main\.js$"; then
  JS_VER=$(git show :src/main.js | sed -n "s/.*NPC_DIAG_BUILD *= *'v\([0-9.]*\)'.*/\1/p" | head -1)
  HTML_VER=$(git show :index.html | sed -n "s/.*HTML build: v\([0-9.]*\).*/\1/p" | head -1)

  # 1. Consistency: both files must agree.
  if [[ "$JS_VER" != "$HTML_VER" ]]; then
    echo "ERROR: src/main.js staged but version mismatch with index.html."
    echo "  main.js: v${JS_VER}  index.html: v${HTML_VER}"
    echo "Run: node ops/scripts/bump_version.mjs +patch && git add index.html src/main.js"
    exit 1
  fi

  # 2. Progress: version must be bumped from the last committed version.
  #    Compares against HEAD's src/main.js so this works on any branch.
  HEAD_VER=$(git show HEAD:src/main.js 2>/dev/null | sed -n "s/.*NPC_DIAG_BUILD *= *'v\([0-9.]*\)'.*/\1/p" | head -1)
  if [[ -n "$HEAD_VER" && "$JS_VER" == "$HEAD_VER" ]]; then
    echo "ERROR: src/main.js changed but version is still v${JS_VER} (same as last commit)."
    echo "Run: node ops/scripts/bump_version.mjs +patch && git add index.html src/main.js"
    exit 1
  fi

  # 3. Feature changes (non-version-only) must update ITERATION.whatsNew so
  #    each release ships with a one-line summary of what's new. Pure version
  #    bumps (only NPC_DIAG_BUILD / version: / buildVersion: lines touched) are
  #    exempt — same exemption used by the enforce-test-first CI check.
  NONVER=$(git diff --cached -- src/main.js \
    | grep "^[+-]" | grep -v "^[+-][+-][+-]" \
    | grep -vE "NPC_DIAG_BUILD|[^a-z]version:|buildVersion:" || true)
  if [[ -n "$NONVER" ]]; then
    EXTRACT='let s="";process.stdin.on("data",c=>s+=c);process.stdin.on("end",()=>{const m=s.match(/whatsNew:\s*\[([\s\S]*?)\],\s*whatsNext:/);process.stdout.write(m?m[1]:"")})'
    HEAD_WN=$(git show HEAD:src/main.js 2>/dev/null | node -e "$EXTRACT")
    STAGED_WN=$(git show :src/main.js | node -e "$EXTRACT")
    if [[ -n "$HEAD_WN" && "$STAGED_WN" == "$HEAD_WN" ]]; then
      echo "ERROR: src/main.js has feature changes but ITERATION.whatsNew was not updated."
      echo ""
      echo "Each release ships with a one-line summary. Add an entry around src/main.js:6375:"
      echo "    whatsNew: ["
      echo "      '<one-line summary of what shipped in v${JS_VER}>',"
      echo "      ...existing entries..."
      echo "    ],"
      echo ""
      echo "If this commit truly has no user-visible change worth noting, you can"
      echo "still satisfy the rule by replacing the oldest entry with the new one."
      exit 1
    fi
  fi
fi
