#!/usr/bin/env bash
# Blocks commits where src/main.js is staged but index.html version doesn't match.
STAGED=$(git diff --cached --name-only)
if echo "$STAGED" | grep -q "^src/main\.js$"; then
  JS_VER=$(git show :src/main.js | sed -n "s/.*NPC_DIAG_BUILD *= *'v\([0-9.]*\)'.*/\1/p" | head -1)
  HTML_VER=$(git show :index.html | sed -n "s/.*HTML build: v\([0-9.]*\).*/\1/p" | head -1)
  if [[ "$JS_VER" != "$HTML_VER" ]]; then
    echo "ERROR: src/main.js staged but version not bumped in index.html."
    echo "  main.js: v${JS_VER}  index.html: v${HTML_VER}"
    echo "Run: node ops/scripts/bump_version.mjs +patch && git add index.html src/main.js"
    exit 1
  fi
fi
